# The Vite dev server proxies /api to the backend (see vite.config.js), so no
# API base URL is needed for local development. In production, leave this
# unset if a reverse proxy serves the frontend and forwards /api/* to the
# backend on the same origin (recommended — simplest, no CORS needed). Set
# this only if the frontend is deployed on a different origin than the API,
# e.g. https://api.yourdomain.com
VITE_API_BASE_URL=
