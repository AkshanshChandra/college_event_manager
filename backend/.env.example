# Copy to .env and fill in real values. Never commit .env.

# --- App ---
ENVIRONMENT=development
DEBUG=true
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# --- Database ---
DATABASE_URL=postgresql+psycopg://localhost/adappt

# --- Auth ---
JWT_SECRET_KEY=change-me-to-a-long-random-value
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
ACTIVATION_TOKEN_EXPIRE_HOURS=24

# --- Storage: "local" writes to disk for development, "s3" requires the AWS_*
# and S3_BUCKET_NAME vars below ---
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=./uploads
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
S3_BUCKET_NAME=
PRESIGNED_URL_EXPIRE_SECONDS=3600

# --- Email: "console" logs emails instead of sending (development), "smtp"
# requires the SMTP_* vars below ---
EMAIL_BACKEND=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM_ADDRESS=noreply@adappt.dev
EMAIL_FROM_NAME=ADAPPT

# --- Registration sync: "csv" reads REGISTRATION_CSV_PATH (development),
# "google_sheets" requires a service account with read access to the sheet ---
REGISTRATION_SYNC_MODE=csv
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SHEET_ID=
GOOGLE_SHEET_WORKSHEET=Form Responses 1
REGISTRATION_CSV_PATH=./dev_data/registrations.csv
GOOGLE_FORM_URL=https://forms.google.com/PLACEHOLDER

# --- Upload limits (also configurable at runtime via Admin > Competition Settings) ---
MAX_DOCUMENT_SIZE_MB=25
MAX_VIDEO_SIZE_MB=300
ALLOWED_DOCUMENT_EXTENSIONS=pdf,ppt,pptx
ALLOWED_VIDEO_EXTENSIONS=mp4,mov,webm
